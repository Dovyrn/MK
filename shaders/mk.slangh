#define BUFFER(n) [[vk::binding(n, 1)]]
#define TEXTURE(n) [[vk::binding(n, 2)]]
#define SAMPLER(n) [[vk::binding(n, 3)]]
#define INPUT(n) [[vk::input_attachment_index(n)]]

#ifdef MK_SPIRV
typealias Uniform<T> = ConstantBuffer<T, Std430DataLayout>;
#else
typealias Uniform<T> = ConstantBuffer<T>;
#endif

#include "atomics.slangh"
#include "bindless.slangh"
#include "indirect.slangh"
