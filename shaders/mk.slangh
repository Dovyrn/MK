#define MK_SAMPLER_2 register(s2)
#define MK_SAMPLER_3 register(s3)

#define ATTACHMENT(n) MK_ATTACHMENT_##n
#define MK_ATTACHMENT_0 [[vk::input_attachment_index(0)]] [[vk::binding(25, 0)]]
#define MK_ATTACHMENT_1 [[vk::input_attachment_index(1)]] [[vk::binding(26, 0)]]
#define MK_ATTACHMENT_2 [[vk::input_attachment_index(2)]] [[vk::binding(27, 0)]]
